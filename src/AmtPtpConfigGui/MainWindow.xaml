<Window x:Class="AmtPtpConfigGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wellspring PTP - Palm Rejection Settings"
        Height="820" Width="1280" MinHeight="660" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>

        <!-- =====================================================================
             Design tokens.

             The previous palette was "generic Fluent" (stock Windows blue,
             flat gray page, every card the same visual weight) - it worked,
             but nothing about it was designed *for this app*. This pass
             keeps the same light, native-feeling chrome but:
               - gives the window an actual identity (brand mark + title/
                 subtitle instead of just a status dot),
               - establishes a real type scale instead of one font size
                 everywhere,
               - turns the trackpad preview into a dark "glass device" panel
                 instead of a plain white rectangle, since that's the one
                 element users actually stare at while calibrating,
               - gives primary/secondary/tertiary actions distinct visual
                 weight instead of every button looking the same.
             ===================================================================== -->

        <SolidColorBrush x:Key="AccentBrush"        Color="#2554C7"/>
        <SolidColorBrush x:Key="AccentBrushHover"    Color="#1F45A6"/>
        <SolidColorBrush x:Key="AccentBrushPressed"  Color="#163578"/>
        <SolidColorBrush x:Key="AccentSoftBrush"     Color="#E8EEFC"/>
        <SolidColorBrush x:Key="CardBrush"           Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush"     Color="#E7E9EC"/>
        <SolidColorBrush x:Key="PageBrush"           Color="#F4F5F7"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#14171C"/>
        <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#6B7280"/>
        <SolidColorBrush x:Key="TextTertiaryBrush"   Color="#9AA1AC"/>
        <SolidColorBrush x:Key="DividerBrush"        Color="#ECEDF0"/>
        <SolidColorBrush x:Key="ControlFillBrush"    Color="#FBFBFC"/>
        <SolidColorBrush x:Key="ControlStrokeBrush"  Color="#D8DBE0"/>
        <SolidColorBrush x:Key="DangerBrush"         Color="#E5484D"/>
        <SolidColorBrush x:Key="DangerSoftBrush"     Color="#FCE9EA"/>
        <SolidColorBrush x:Key="SuccessBrush"        Color="#1D9A6C"/>
        <SolidColorBrush x:Key="SuccessSoftBrush"    Color="#E7F6EF"/>

        <LinearGradientBrush x:Key="BrandMarkBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3A6BF0" Offset="0"/>
            <GradientStop Color="#2554C7" Offset="1"/>
        </LinearGradientBrush>

        <!-- Bezel around the trackpad "device" panel, and the glass shine
             overlay drawn on top of it - see the preview column below. -->
        <LinearGradientBrush x:Key="BezelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#20232B" Offset="0"/>
            <GradientStop Color="#15171C" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassShineBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#22FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.45"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow"
                           Color="#0B0D10" Opacity="0.06"
                           BlurRadius="22" ShadowDepth="2" Direction="270"/>
        <DropShadowEffect x:Key="DeviceShadow"
                           Color="#0B0D10" Opacity="0.22"
                           BlurRadius="26" ShadowDepth="6" Direction="270"/>
        <DropShadowEffect x:Key="ThumbShadow"
                           Color="#000000" Opacity="0.20"
                           BlurRadius="6" ShadowDepth="1" Direction="270"/>
        <DropShadowEffect x:Key="PrimaryButtonShadow"
                           Color="#2554C7" Opacity="0.30"
                           BlurRadius="14" ShadowDepth="3" Direction="270"/>

        <!-- Gentle breathing pulse for the Live telemetry dot - started/
             stopped from code-behind in Live_Changed / SetLiveDot(). -->
        <Storyboard x:Key="LivePulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="LiveDot"
                              Storyboard.TargetProperty="Opacity"
                              From="1.0" To="0.32" Duration="0:0:0.9"/>
        </Storyboard>

        <!-- ===================== Base text + type scale ===================== -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SubtitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <!-- Numeric/telemetry readouts get a monospace face - tabular
             figures line up column-to-column as values change, which a
             proportional UI font (Segoe UI) can't do. Small, deliberate
             detail that makes the live readout feel like instrumentation
             instead of a sentence that happens to contain numbers. -->
        <Style x:Key="TelemetryText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- ===================== Card container ===================== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- ===================== GroupBox re-skinned as a settings card
             with a left accent rule + two-line (title/caption) header,
             set via GroupBox.Header (rich content, not just a string). ==== -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="18,16,18,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" CornerRadius="2"
                                        Background="{StaticResource AccentBrush}"
                                        Margin="0,16"/>
                                <StackPanel Grid.Column="1" Margin="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" Margin="0,0,0,14"/>
                                    <ContentPresenter/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reusable header content for a settings card: bold title on top,
             muted caption underneath. Used as GroupBox.Header below. -->
        <Style x:Key="SettingsSectionHeader" TargetType="StackPanel"/>

        <!-- Standardizes the vertical rhythm between "label + value" rows
             inside a settings card, so every slider row uses the same
             spacing instead of each one being hand-tuned inline. -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <!-- ===================== Slider labels ===================== -->
        <Style TargetType="TextBlock" x:Key="SliderLabel">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SliderValue">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- ===================== Slider ===================== -->
        <Style x:Key="FluentSliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Halo" Width="24" Height="24"
                                     Fill="#140067C0" Opacity="0"/>
                            <Ellipse Width="18" Height="18"
                                     Fill="White"
                                     Stroke="{StaticResource AccentBrush}"
                                     StrokeThickness="2"
                                     Effect="{StaticResource ThumbShadow}"/>
                            <Ellipse x:Name="Core" Width="8" Height="8"
                                     Fill="{StaticResource AccentBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Core" Property="Fill" Value="{StaticResource AccentBrushPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,3,0,14"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickPlacement" Value="None"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" Background="{StaticResource ControlStrokeBrush}" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#5B8CF0" Offset="0"/>
                                                            <GradientStop Color="#2554C7" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FluentSliderThumb}" Width="18" Height="18"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== Buttons =====================
             Three tiers: default (secondary, outlined), AccentButton
             (primary - "Застосувати"), GhostButton (tertiary, text-only -
             "Скинути за замовчуванням", a destructive-ish but infrequent
             action that shouldn't visually compete with Apply). -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Background" Value="{StaticResource ControlFillBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E6E6E6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action - "Застосувати". Slightly larger, filled accent,
             soft colored elevation shadow so it visibly outranks every
             other button on screen instead of matching them 1:1. -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Effect" Value="{StaticResource PrimaryButtonShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrushHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrushPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tertiary action - "Скинути за замовчуванням". No fill, no
             border, muted text - present but doesn't compete with Apply. -->
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ControlFillBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource DividerBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== CheckBox ===================== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                    Background="White"
                                    BorderBrush="{StaticResource ControlStrokeBrush}"
                                    BorderThickness="1.4"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M2,7 L6,11 L14,2" Stroke="White"
                                      StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "Live" mode toggle, styled as a pill chip rather than a plain
             checkbox - it's a persistent mode switch (like a mic-mute
             toggle), a different interaction than the one-off option
             checkboxes elsewhere (e.g. ChkIsBirth), so it gets a visibly
             different affordance instead of reusing the same widget for
             two different jobs. -->
        <Style x:Key="ToggleChip" TargetType="CheckBox">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Chip" CornerRadius="16"
                                Background="{StaticResource ControlFillBrush}"
                                BorderBrush="{StaticResource ControlStrokeBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="7" Height="7"
                                         Fill="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small colored legend/status pill used in the preview header and
             the connection indicator. -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="18">

        <!-- ===================== Header: brand + connection status ===================== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource BrandMarkBrush}">
                        <Grid>
                            <Ellipse Width="9" Height="9" Fill="#B8FFFFFF"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,8,0,0"/>
                            <Ellipse Width="13" Height="13" Fill="White"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,7"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Wellspring PTP" Style="{StaticResource TitleText}"/>
                        <TextBlock Text="Калібрування відхилення долоні (Palm Rejection)" Style="{StaticResource SubtitleText}"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource Pill}"
                        Background="{StaticResource ControlFillBrush}"
                        BorderBrush="{StaticResource ControlStrokeBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#E5484D" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Margin="9,0,0,0" VerticalAlignment="Center"
                                   Text="Пристрій не знайдено — режим попереднього перегляду"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== Toolbar: Live monitor + diagnostics ===================== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkLive" Style="{StaticResource ToggleChip}" Content="Live"
                              VerticalAlignment="Center"
                              Checked="Live_Changed" Unchecked="Live_Changed"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="#9AA1AC" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LiveStatusText" Text="Live: вимкнено"
                                   Style="{StaticResource TelemetryText}" Margin="7,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock x:Name="LiveCoordText" Text="Live: координати —"
                               Style="{StaticResource TelemetryText}" MaxWidth="620" Margin="0,0,16,0"/>
                    <TextBlock x:Name="LiveCornerText" Text="Кути: TL 0 | TR 0 | BL 0 | BR 0"
                               Style="{StaticResource TelemetryText}" MaxWidth="320"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Зберегти помилки в .txt" Click="SaveErrors_Click"/>
                    <Button Click="Reconnect_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Оновити / Reconnect" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Bottom action bar ===================== -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BottomStatusText" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text=""/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Скинути за замовчуванням" Style="{StaticResource GhostButton}" Click="ResetDefaults_Click"/>
                    <Border Width="1" Margin="10,4" Background="{StaticResource DividerBrush}"/>
                    <Button Content="Завантажити профіль…" Click="LoadProfile_Click"/>
                    <Button Content="Зберегти профіль…" Click="SaveProfile_Click"/>
                    <Button Style="{StaticResource AccentButton}" Click="Apply_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Застосувати" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Main content: settings (left, scrollable) + live preview (right) ===================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <GroupBox>
                        <GroupBox.Header>
                            <StackPanel>
                                <TextBlock Text="Крайова зона" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="EDGE ZONE · % від розміру тачпада" Style="{StaticResource SectionCaption}"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Верх (Top)"/>
                                <TextBlock x:Name="LblEdgeTop" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlEdgeTop" Minimum="0" Maximum="400" ValueChanged="Slider_Changed"/>

                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Ліво (Left)"/>
                                <TextBlock x:Name="LblEdgeLeft" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlEdgeLeft" Minimum="0" Maximum="400" ValueChanged="Slider_Changed"/>

                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Право (Right)"/>
                                <TextBlock x:Name="LblEdgeRight" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlEdgeRight" Minimum="0" Maximum="400" ValueChanged="Slider_Changed"/>

                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Низ (Bottom)"/>
                                <TextBlock x:Name="LblEdgeBottom" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlEdgeBottom" Minimum="0" Maximum="400" ValueChanged="Slider_Changed"/>

                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Новий дотик, що з'явився в цій зоні, миттєво відхиляється як долоня — незалежно від форми."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox>
                        <GroupBox.Header>
                            <StackPanel>
                                <TextBlock Text="Поріг форми долоні" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="PALM SHAPE" Style="{StaticResource SectionCaption}"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Large Major (жорстке відхилення)"/>
                                <TextBlock x:Name="LblLargeMajor" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlLargeMajor" Minimum="50" Maximum="800" ValueChanged="Slider_Changed"/>

                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Large Ratio, Major/Minor ×100"/>
                                <TextBlock x:Name="LblLargeRatio" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlLargeRatio" Minimum="100" Maximum="500" ValueChanged="Slider_Changed"/>

                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Поріг балів (Score Threshold)"/>
                                <TextBlock x:Name="LblScoreThresh" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlScoreThresh" Minimum="5" Maximum="150" ValueChanged="Slider_Changed"/>

                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Мінімальний Major"/>
                                <TextBlock x:Name="LblMinMajor" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlMinMajor" Minimum="0" Maximum="300" ValueChanged="Slider_Changed"/>

                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Мінімальний Minor"/>
                                <TextBlock x:Name="LblMinMinor" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlMinMinor" Minimum="0" Maximum="300" ValueChanged="Slider_Changed"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Margin="0,0,0,0">
                        <GroupBox.Header>
                            <StackPanel>
                                <TextBlock Text="Тестовий дотик" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="PREVIEW · не впливає на драйвер" Style="{StaticResource SectionCaption}"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Major (розмір пальця)"/>
                                <TextBlock x:Name="LblTestMajor" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlTestMajor" Minimum="0" Maximum="600" ValueChanged="Slider_Changed"/>

                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Minor (ширина пальця)"/>
                                <TextBlock x:Name="LblTestMinor" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlTestMinor" Minimum="0" Maximum="600" ValueChanged="Slider_Changed"/>

                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Позиція X (0=ліво, 100=право)"/>
                                <TextBlock x:Name="LblTestX" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlTestX" Minimum="0" Maximum="100" Value="50" ValueChanged="Slider_Changed"/>

                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Позиція Y (0=верх, 100=низ)"/>
                                <TextBlock x:Name="LblTestY" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlTestY" Minimum="0" Maximum="100" Value="50" ValueChanged="Slider_Changed"/>

                            <CheckBox x:Name="ChkIsBirth" Content="Новий дотик (birth) — не продовження вже активного" IsChecked="True"
                                      Margin="0,8,0,0" Checked="Slider_Changed" Unchecked="Slider_Changed"/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Перетягніть точку прямо на карті праворуч, щоб перевірити позицію дотику."/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- ===================== Live visualization ===================== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="Попередній перегляд тачпада" Style="{StaticResource SectionTitle}" FontSize="16" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource Pill}" Background="{StaticResource SuccessSoftBrush}" Padding="9,3" Margin="14,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="звичайний дотик" FontSize="10.5" Margin="6,0,0,0"
                                           Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Pill}" Background="{StaticResource DangerSoftBrush}" Padding="9,3" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="долоня (PALM)" FontSize="10.5" Margin="6,0,0,0"
                                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- "Device" bezel around the trackpad glass: a dark
                         frame (like the plastic/metal surround on a real
                         trackpad) with a soft drop shadow, containing the
                         canvas the driver-accurate classification is drawn
                         on, plus a faint diagonal glass-shine overlay. The
                         canvas itself is filled in code (DrawPreview) with
                         a dark radial/linear "glass" gradient rather than a
                         flat white rectangle. -->
                    <Border Grid.Row="1" CornerRadius="16" Background="{StaticResource BezelBrush}"
                            Padding="14" Effect="{StaticResource DeviceShadow}">
                        <Grid>
                            <Border CornerRadius="10" ClipToBounds="True">
                                <Viewbox Stretch="Uniform">
                                    <Canvas x:Name="PreviewCanvas" Width="700" Height="460" Background="Transparent"
                                            MouseLeftButtonDown="PreviewCanvas_MouseDown"
                                            MouseMove="PreviewCanvas_MouseMove"
                                            MouseLeftButtonUp="PreviewCanvas_MouseUp"/>
                                </Viewbox>
                            </Border>
                            <Border CornerRadius="10" Background="{StaticResource GlassShineBrush}" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Margin="0,14,0,0" Padding="14,11" CornerRadius="8"
                            Background="{StaticResource ControlFillBrush}"
                            BorderBrush="{StaticResource ControlStrokeBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Класифікація: " FontWeight="SemiBold"/>
                            <TextBlock x:Name="ClassificationText" Text="—" FontWeight="Bold"/>
                            <TextBlock x:Name="GeometrySourceText" Margin="20,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
