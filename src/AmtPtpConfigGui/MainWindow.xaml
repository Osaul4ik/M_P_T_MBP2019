<Window x:Class="AmtPtpConfigGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wellspring PTP - Palm Rejection Settings"
        Height="760" Width="1180" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8,10,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,10"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickPlacement" Value="None"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SliderLabel">
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SliderValue">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2A6FDB"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Top status bar -->
        <Border DockPanel.Dock="Top" Background="#F3F5F8" BorderBrush="#DDE1E6" BorderThickness="0,0,0,1">
            <Grid Margin="14,10,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#C0392B" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                           Text="Пристрій не знайдено — режим попереднього перегляду"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <CheckBox x:Name="ChkLive"
                              Content="Live"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0"
                              Checked="Live_Changed"
                              Unchecked="Live_Changed"/>

                    <TextBlock x:Name="LiveStatusText"
                               Text="Live: вимкнено"
                               VerticalAlignment="Center"
                               Foreground="#666"
                               Margin="0,0,14,0"/>

                    <Button Content="Зберегти помилки в .txt" Click="SaveErrors_Click" Margin="0,0,6,0"/>
                    <Button Content="Оновити / Reconnect" Click="Reconnect_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom action bar -->
        <Border DockPanel.Dock="Bottom" Background="#F3F5F8" BorderBrush="#DDE1E6" BorderThickness="0,1,0,0">
            <Grid Margin="14,10,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BottomStatusText" VerticalAlignment="Center" Foreground="#555" Text=""/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Завантажити профіль…" Click="LoadProfile_Click"/>
                    <Button Content="Зберегти профіль…" Click="SaveProfile_Click"/>
                    <Button Content="Скинути за замовчуванням" Click="ResetDefaults_Click"/>
                    <Button Content="Застосувати" Background="#2A6FDB" Foreground="White" Click="Apply_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content: settings (left, scrollable) + live preview (right) -->
        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <GroupBox Header="Крайова зона (Edge Zone) — % від розміру тачпада">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Верх (Top)"/>
                                <TextBlock x:Name="LblEdgeTop" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlEdgeTop" Minimum="0" Maximum="400" ValueChanged="Slider_Changed"/>

                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Ліво (Left)"/>
                                <TextBlock x:Name="LblEdgeLeft" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlEdgeLeft" Minimum="0" Maximum="400" ValueChanged="Slider_Changed"/>

                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Право (Right)"/>
                                <TextBlock x:Name="LblEdgeRight" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlEdgeRight" Minimum="0" Maximum="400" ValueChanged="Slider_Changed"/>

                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Низ (Bottom)"/>
                                <TextBlock x:Name="LblEdgeBottom" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlEdgeBottom" Minimum="0" Maximum="400" ValueChanged="Slider_Changed"/>

                            <TextBlock TextWrapping="Wrap" Foreground="#777" FontWeight="Normal" FontSize="11"
                                       Text="Новий дотик, що з'явився в цій зоні, миттєво відхиляється як долоня — незалежно від форми."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Поріг форми долоні (Palm Shape)">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Large Major (жорстке відхилення)"/>
                                <TextBlock x:Name="LblLargeMajor" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlLargeMajor" Minimum="50" Maximum="800" ValueChanged="Slider_Changed"/>

                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Large Ratio, Major/Minor ×100"/>
                                <TextBlock x:Name="LblLargeRatio" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlLargeRatio" Minimum="100" Maximum="500" ValueChanged="Slider_Changed"/>

                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Поріг балів (Score Threshold)"/>
                                <TextBlock x:Name="LblScoreThresh" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlScoreThresh" Minimum="5" Maximum="150" ValueChanged="Slider_Changed"/>

                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Мінімальний Major"/>
                                <TextBlock x:Name="LblMinMajor" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlMinMajor" Minimum="0" Maximum="300" ValueChanged="Slider_Changed"/>

                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Мінімальний Minor"/>
                                <TextBlock x:Name="LblMinMinor" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlMinMinor" Minimum="0" Maximum="300" ValueChanged="Slider_Changed"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Тестовий дотик (Preview) — не впливає на драйвер">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Major (розмір пальця)"/>
                                <TextBlock x:Name="LblTestMajor" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlTestMajor" Minimum="0" Maximum="600" ValueChanged="Slider_Changed"/>

                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Minor (ширина пальця)"/>
                                <TextBlock x:Name="LblTestMinor" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlTestMinor" Minimum="0" Maximum="600" ValueChanged="Slider_Changed"/>

                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Позиція X (0=ліво, 100=право)"/>
                                <TextBlock x:Name="LblTestX" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlTestX" Minimum="0" Maximum="100" Value="50" ValueChanged="Slider_Changed"/>

                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Позиція Y (0=верх, 100=низ)"/>
                                <TextBlock x:Name="LblTestY" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlTestY" Minimum="0" Maximum="100" Value="50" ValueChanged="Slider_Changed"/>

                            <CheckBox x:Name="ChkIsBirth" Content="Новий дотик (birth) — не продовження вже активного" IsChecked="True"
                                      Margin="0,4,0,4" Checked="Slider_Changed" Unchecked="Slider_Changed"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#777" FontWeight="Normal" FontSize="11" Margin="0,4,0,0"
                                       Text="Перетягніть точку прямо на карті праворуч, щоб перевірити позицію дотику."/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- Live visualization -->
            <Border Grid.Column="2" BorderBrush="#DDE1E6" BorderThickness="1" Background="White" CornerRadius="6">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Попередній перегляд тачпада" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>

                    <Viewbox Grid.Row="1" Stretch="Uniform">
                        <Canvas x:Name="PreviewCanvas" Width="700" Height="460" Background="#FAFBFC"
                                MouseLeftButtonDown="PreviewCanvas_MouseDown"
                                MouseMove="PreviewCanvas_MouseMove"
                                MouseLeftButtonUp="PreviewCanvas_MouseUp"/>
                    </Viewbox>

                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="10,8" CornerRadius="4" Background="#F3F5F8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Класифікація: " FontWeight="SemiBold"/>
                            <TextBlock x:Name="ClassificationText" Text="—" FontWeight="Bold"/>
                            <TextBlock x:Name="GeometrySourceText" Margin="20,0,0,0" Foreground="#888"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
