<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AmtPtpConfigGui</RootNamespace>
    <AssemblyName>Wellspring Control Center</AssemblyName>
    <Product>Wellspring Control Center</Product>
    <AssemblyTitle>Wellspring Control Center</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <SatelliteResourceLanguages>uk;en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContained>false</SelfContained>

    <!--
      Workstation, non-concurrent GC instead of the WinExe-default
      background-concurrent mode: background GC keeps an extra dedicated
      thread and heap segment resident for the whole process lifetime to
      shave collection pauses the user would notice while interacting with
      the window. For a small utility that spends most of its life sitting
      idle in the tray, that standing cost isn't worth it - TrayMemoryTrimmer
      already does a blocking, compacting collect right before it asks the
      OS to page the working set out, so foreground pause time here is a
      one-off on hide, not a per-frame concern.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

</Project>